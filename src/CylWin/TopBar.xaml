<Window x:Class="CylWin.TopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyl Win"
        Width="760" Height="38"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">

  <Grid>
  <Border x:Name="Bar" CornerRadius="12" Background="{StaticResource Glass}"
          BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="4,0,6,0">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Fixar barra (não esconder)" x:Name="PinItem" IsCheckable="True" Click="Pin_Click"/>
        <Separator/>
        <MenuItem Header="Sair do Cyl Win" Click="Exit_Click"/>
      </ContextMenu>
    </Border.ContextMenu>

    <DockPanel LastChildFill="False" VerticalAlignment="Center">

      <!-- Esquerda: botão do PC -->
      <Button x:Name="PcButton" DockPanel.Dock="Left" Style="{StaticResource BarButton}"
              ToolTip="Clique para abrir o Gerenciador de Tarefas" Click="PcButton_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" Margin="0,0,7,0"/>
          <TextBlock Text="Cyl" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <!-- Direita: rede, som, notificações, relógio -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource BarButton}" ToolTip="Rede" Click="Net_Click">
          <TextBlock x:Name="NetIcon" Style="{StaticResource Icon}" Text="&#xE701;"/>
        </Button>
        <Button Style="{StaticResource BarButton}" ToolTip="Volume por app" Click="Volume_Click">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE767;"/>
        </Button>
        <Button Style="{StaticResource BarButton}" ToolTip="Notificações" Click="Notifications_Click">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE91C;"/>
        </Button>
        <Button Style="{StaticResource BarButton}" Click="Clock_Click" ToolTip="Calendário">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DateText" Foreground="{StaticResource InkSoft}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClockText" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>

  <!-- O modal do PC: abre ao passar o mouse no botão "Cyl" -->
  <Popup x:Name="PcPopup" PlacementTarget="{Binding ElementName=PcButton}" Placement="Bottom"
         VerticalOffset="12" HorizontalOffset="-4" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
    <Border x:Name="PcPanel" Width="300" CornerRadius="14" Background="{StaticResource GlassStrong}"
            BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="16,14">
      <StackPanel>
        <TextBlock Text="Meu PC" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Ink}" Margin="0,0,0,4"/>

        <Grid x:Name="RowCpu" Margin="0,8,0,0"/>
        <Grid x:Name="RowTemp" Margin="0,8,0,0"/>
        <Grid x:Name="RowGpu" Margin="0,8,0,0"/>
        <Grid x:Name="RowRam" Margin="0,8,0,0"/>

        <TextBlock x:Name="NetText" Margin="0,14,0,0" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="InfoText" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource InkSoft}"/>
      </StackPanel>
    </Border>
  </Popup>
  </Grid>
</Window>
